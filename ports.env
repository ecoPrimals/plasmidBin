# plasmidBin/ports.env — LEGACY: TCP port assignments (Tier 5 fallback only)
#
# DEPRECATED as of Wave 79. UDS-only is now the default for all deployments.
# TCP ports are Tier 5 fallback — gated behind tcp_tier5_enabled() in
# primalSpring and only active in debug builds or explicit --tcp flag.
#
# SSOT: primalSpring ecoPrimal/src/tolerances/mod.rs
# Last reconciled: 2026-06-05 (Wave 79)
#
# These ports exist ONLY for:
#   - ADB port forwarding (Android/Pixel — no UDS)
#   - benchScale Docker topologies (legacy test harness)
#   - Desktop debug builds with --tcp flag
#
# VPS, LAN gates, and all production deployments use UDS-only.
# All NUCLEUS primals communicate via /run/membrane/*.sock or
# XDG_RUNTIME_DIR/biomeos/ sockets. Songbird :7700 is the only
# legitimate TCP surface (federation).
#
# Override any port: BEARDOG_PORT=9100 ./start_primal.sh beardog
#
# This file is kept in sync with primalSpring tolerances/mod.rs.

# ── Foundation primals (NUCLEUS) ─────────────────────────────────────
BEARDOG_PORT="${BEARDOG_PORT:-9100}"
SONGBIRD_PORT="${SONGBIRD_PORT:-9200}"
SQUIRREL_PORT="${SQUIRREL_PORT:-9300}"
TOADSTOOL_PORT="${TOADSTOOL_PORT:-9400}"
NESTGATE_PORT="${NESTGATE_PORT:-9500}"
PETALTONGUE_PORT="${PETALTONGUE_PORT:-9900}"
LUDOSPRING_PORT="${LUDOSPRING_PORT:-9650}"
ESOTERICWEBB_PORT="${ESOTERICWEBB_PORT:-9660}"

# ── Post-NUCLEUS primals ─────────────────────────────────────────────
RHIZOCRYPT_PORT="${RHIZOCRYPT_PORT:-9601}"
LOAMSPINE_PORT="${LOAMSPINE_PORT:-9700}"
SWEETGRASS_PORT="${SWEETGRASS_PORT:-9850}"
CORALREEF_PORT="${CORALREEF_PORT:-9730}"
BARRACUDA_PORT="${BARRACUDA_PORT:-9740}"
SKUNKBAT_PORT="${SKUNKBAT_PORT:-9140}"

# ── Orchestrator ─────────────────────────────────────────────────────
BIOMEOS_PORT="${BIOMEOS_PORT:-9800}"

# ── Springs (science validation) ─────────────────────────────────────
GROUNDSPRING_PORT="${GROUNDSPRING_PORT:-9855}"
HEALTHSPRING_PORT="${HEALTHSPRING_PORT:-9860}"
NEURALSPRING_PORT="${NEURALSPRING_PORT:-9870}"
WETSPRING_PORT="${WETSPRING_PORT:-9880}"
PRIMALSPRING_PORT="${PRIMALSPRING_PORT:-9890}"

# ── Composition definitions (Phase 40 atomic-aligned — NUCLEUS Complete) ──
# Tower (electron): trust boundary — Phase 32 (beardog + songbird + skunkbat)
COMP_TOWER="beardog songbird skunkbat"
# Node (proton): Tower + compute substrate
COMP_NODE="beardog songbird skunkbat toadstool barracuda coralreef"
# Nest (neutron): Tower + storage + provenance
COMP_NEST="beardog songbird skunkbat nestgate rhizocrypt loamspine sweetgrass"
# NUCLEUS (atom): Tower + Node + Nest (10 unique primals)
COMP_NUCLEUS="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass"
# Meta-tier: cross-atomic orchestration, AI, UI
COMP_META="biomeos squirrel petaltongue"
# NUCLEUS + Meta: full deployment (13 primals)
COMP_FULL="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass biomeos squirrel petaltongue"
# Legacy aliases
COMP_COMPUTE="beardog songbird skunkbat toadstool barracuda coralreef"
COMP_PROVENANCE="beardog songbird skunkbat rhizocrypt loamspine sweetgrass"
COMP_STORYTELLING="beardog songbird skunkbat biomeos squirrel petaltongue ludospring"
COMP_SCIENCE="beardog songbird skunkbat toadstool barracuda coralreef biomeos squirrel"
COMP_NUCLEUS_FULL="$COMP_FULL"
# fieldMouse: depot/beacon/archive (tower + nest, no compute/meta) — VPS, NAS, edge
COMP_FIELDMOUSE="$COMP_NEST"
# depot: minimal signal/rendezvous (tower only) — relay nodes, beacons
COMP_DEPOT="$COMP_TOWER"

# ── Per-spring niche compositions ─────────────────────────────────────
# What primals each spring needs deployed to validate its science.
# Use with: ./validate_composition.sh niche-<spring>
NICHE_HOTSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass"
NICHE_NEURALSPRING="beardog songbird skunkbat toadstool barracuda coralreef biomeos squirrel"
NICHE_WETSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass biomeos squirrel petaltongue"
NICHE_AIRSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass"
NICHE_GROUNDSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass"
NICHE_HEALTHSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass biomeos squirrel petaltongue"
NICHE_LUDOSPRING="beardog songbird skunkbat toadstool barracuda coralreef nestgate rhizocrypt loamspine sweetgrass biomeos squirrel petaltongue"

primals_for_composition() {
    case "$1" in
        tower)        echo "$COMP_TOWER" ;;
        node)         echo "$COMP_NODE" ;;
        nest)         echo "$COMP_NEST" ;;
        nucleus)      echo "$COMP_NUCLEUS" ;;
        meta)         echo "$COMP_META" ;;
        full)         echo "$COMP_FULL" ;;
        compute)      echo "$COMP_COMPUTE" ;;
        storytelling) echo "$COMP_STORYTELLING" ;;
        provenance)   echo "$COMP_PROVENANCE" ;;
        science)      echo "$COMP_SCIENCE" ;;
        nucleus-full) echo "$COMP_NUCLEUS_FULL" ;;
        fieldmouse|fieldMouse) echo "$COMP_FIELDMOUSE" ;;
        depot)        echo "$COMP_DEPOT" ;;
        niche-hotspring)    echo "$NICHE_HOTSPRING" ;;
        niche-neuralspring) echo "$NICHE_NEURALSPRING" ;;
        niche-wetspring)    echo "$NICHE_WETSPRING" ;;
        niche-airspring)    echo "$NICHE_AIRSPRING" ;;
        niche-groundspring) echo "$NICHE_GROUNDSPRING" ;;
        niche-healthspring) echo "$NICHE_HEALTHSPRING" ;;
        niche-ludospring)   echo "$NICHE_LUDOSPRING" ;;
        *)            echo "ERROR: Unknown composition: $1" >&2; return 1 ;;
    esac
}

port_for_primal() {
    case "$1" in
        beardog)       echo "$BEARDOG_PORT" ;;
        songbird)      echo "$SONGBIRD_PORT" ;;
        squirrel)      echo "$SQUIRREL_PORT" ;;
        toadstool)     echo "$TOADSTOOL_PORT" ;;
        nestgate)      echo "$NESTGATE_PORT" ;;
        petaltongue)   echo "$PETALTONGUE_PORT" ;;
        ludospring)    echo "$LUDOSPRING_PORT" ;;
        esotericwebb)  echo "$ESOTERICWEBB_PORT" ;;
        rhizocrypt)    echo "$RHIZOCRYPT_PORT" ;;
        loamspine)     echo "$LOAMSPINE_PORT" ;;
        sweetgrass)    echo "$SWEETGRASS_PORT" ;;
        coralreef)     echo "$CORALREEF_PORT" ;;
        barracuda)     echo "$BARRACUDA_PORT" ;;
        skunkbat)      echo "$SKUNKBAT_PORT" ;;
        biomeos)       echo "$BIOMEOS_PORT" ;;
        groundspring)  echo "$GROUNDSPRING_PORT" ;;
        healthspring)  echo "$HEALTHSPRING_PORT" ;;
        neuralspring)  echo "$NEURALSPRING_PORT" ;;
        wetspring)     echo "$WETSPRING_PORT" ;;
        primalspring)  echo "$PRIMALSPRING_PORT" ;;
        *)             echo "0" ;;
    esac
}

# All primals that can be stopped/managed
ALL_PRIMALS="beardog songbird nestgate toadstool barracuda coralreef squirrel biomeos petaltongue rhizocrypt loamspine sweetgrass skunkbat"

# Springs that produce server binaries
ALL_SPRINGS="ludospring groundspring healthspring_primal neuralspring wetspring"
