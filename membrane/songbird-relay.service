#
# Membrane Channel 2: Relay — Songbird TURN relay
#
# Provides NAT traversal for NUCLEUS peers behind symmetric NAT.
# Traffic is BTSP-encrypted end-to-end; the relay sees only opaque bytes.
#
# See: wateringHole/MEMBRANE_CHANNEL_ARCHITECTURE.md (Channel 2: Relay)
# See: wateringHole/handoffs/SONGBIRD_WAVE202_RELAY_OPS_DEPLOYMENT_MAY12_2026.md
#
# Install:
#   cp songbird-relay.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now songbird-relay

[Unit]
Description=Songbird TURN Relay (Membrane Channel 2)
Documentation=https://primals.eco
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/opt/membrane/songbird relay \
    --bind 0.0.0.0 \
    --port 3478 \
    --credentials-file /etc/songbird/relay-credentials

Environment=SONGBIRD_TURN_USERNAME=nucleus-relay

Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/membrane
ReadOnlyPaths=/etc/songbird

# Allow binding to privileged port 3478 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Limit resource usage
MemoryMax=128M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
