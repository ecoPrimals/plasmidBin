# Membrane Channel 3 — Caddy TLS Surface
#
# Version-controlled source of truth for /etc/membrane/Caddyfile on VPS.
# Deploy via: deploy_membrane.sh deploy <user@host> --channel3
#
# Domains:
#   membrane.primals.eco  — sovereign surface (sporePrint cache, health, status)
#   lab.primals.eco       — static lab pages on VPS, interactive hub stays on gate
#   git.primals.eco       — golgiBody periplasmic Forgejo (sovereign git forge)
#
# Transitional: Caddy handles TLS termination until Songbird absorbs it.

{
	email ops@primals.eco
}

# Primary sovereign surface
membrane.primals.eco {
	handle /health {
		respond "membrane-relay TLS active" 200
	}

	handle /status {
		respond "Channel 3 — sovereign TLS operational" 200
	}

	handle /hooks/* {
		reverse_proxy unix//run/membrane/nestgate.sock
	}

	handle {
		root * /var/cache/membrane/nestgate
		file_server
		try_files {path} {path}/ /index.html
	}
}

# Lab static surface (intra layer — VPS-hosted dashboard)
# Interactive paths (JupyterHub) remain gate-local until BTSP relay is wired.
# Static lab content served from pappusCast rsync target.
lab.primals.eco {
	handle /hub/* {
		respond "JupyterHub is gate-local. Connect via LAN or BTSP relay (pending)." 503
	}

	handle /user/* {
		respond "JupyterHub is gate-local. Connect via LAN or BTSP relay (pending)." 503
	}

	handle /api/* {
		respond "JupyterHub is gate-local. Connect via LAN or BTSP relay (pending)." 503
	}

	handle /services/* {
		respond "JupyterHub is gate-local. Connect via LAN or BTSP relay (pending)." 503
	}

	handle {
		root * /var/cache/membrane/lab
		file_server
		try_files {path} {path}/ /index.html
	}
}

# golgiBody — Periplasmic Forgejo (sovereign git forge)
# Packages, routes, and modifies git traffic between gate cytoplasms
# and the extracellular GitHub trailing mirror.
# Phase A: Caddy reverse-proxies to local Forgejo on :3000.
git.primals.eco {
	reverse_proxy localhost:3000
}
