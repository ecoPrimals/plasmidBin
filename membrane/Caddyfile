		}
	}
	handle /epitope-feed {
		reverse_proxy localhost:9753 {
			header_up X-Declared-Lang {>Accept-Language}
			header_up X-Declared-Sec {>Sec-Fetch-Mode}
		}
	}

	# Epitope inversion — fleet movement graph
	handle /epitope-inversion.json {
		reverse_proxy localhost:9753 {
			header_up X-Declared-Lang {>Accept-Language}
			header_up X-Declared-Sec {>Sec-Fetch-Mode}
		}
	}
	handle /epitope-inversion {
		reverse_proxy localhost:9753 {
			header_up X-Declared-Lang {>Accept-Language}
