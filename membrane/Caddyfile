# Cross-forge immunity network
# Peers: git.primals.eco, bloom.primals.eco
# Schema: ecoPrimals/epitope-feed/v1
# License: AGPL-3.0-or-later WITH scyBorg
"
	}

	# All other paths → scatter server (lure content)
	handle {
		# Add headers that make this look like an independent forge
		header X-Forge-ID "forge.primals.eco"
		header X-Federation-Schema "ecoPrimals/epitope-feed/v1"
		header X-Epitope-Feed "/epitope-feed.json"
		header X-License "AGPL-3.0-or-later; scyBorg"
		header X-Legal-Notice "This content is AGPL-3.0-or-later + scyBorg licensed. Any use, storage, processing, or derivation triggers copyleft obligations."
