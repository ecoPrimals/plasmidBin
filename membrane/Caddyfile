# ======================================================================
# WILDCARD MEMBRANE -- Wave 172
# ======================================================================
# The aperture: any subdomain -> epitope sorter -> content decision
# 
# Uses on-demand TLS (individual certs per subdomain on first request).
# DNS wildcard *.primals.eco resolves all subdomains to golgiBody.
# Caddy provisions certs via HTTP-01 challenge.
# The ask endpoint (scatter /can-serve) prevents cert flooding.
#
# H(data|epitope) < H(data|alphabet) < H(data)
# ======================================================================

https:// {
	tls {
		on_demand
	}

	import security_headers
	import access_log
	encode gzip

	# -- Known static sites (sovereign content) --
	@is_sporeprint host sporeprint.primals.eco footprint.primals.eco spore.primals.eco print.primals.eco
	handle @is_sporeprint {
		root * /opt/ecoPrimals/sporePrint/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_thesis host thesis.primals.eco paper.primals.eco whitepaper.primals.eco
	handle @is_thesis {
		root * /opt/ecoPrimals/thesis/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_signal host signal.primals.eco dashboard.primals.eco monitor.primals.eco
	handle @is_signal {
		root * /opt/ecoPrimals/signal/site/public

		handle /billboard* {
			root * /opt/membrane/live-terminal
			header Cache-Control "no-cache, no-store"
			header Access-Control-Allow-Origin "*"
			file_server
		}

		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_tuebor host tuebor.primals.eco barry.primals.eco
	handle @is_tuebor {
		root * /opt/ecoPrimals/tuebor-repo/site/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_detroit host detroit.primals.eco evidence.primals.eco cashforkids.primals.eco
	handle @is_detroit {
		root * /opt/ecoPrimals/detroit/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_clutch host clutch.primals.eco
	handle @is_clutch {
		root * /opt/ecoPrimals/clutch/site/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_gorilla host gorilla.primals.eco guerillagorilla.primals.eco
	handle @is_gorilla {
		root * /opt/ecoPrimals/guerillaGorilla/site/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_hypothesis host hypothesis.primals.eco questions.primals.eco
	handle @is_hypothesis {
		root * /opt/ecoPrimals/hypothesis/site/public
		try_files {path} {path}/index.html /index.html
		file_server
	}

	@is_beacon host beacon.primals.eco relay.primals.eco commensal.primals.eco
	handle @is_beacon {
		root * /opt/membrane/beacon-page
		file_server
	}

	# -- Honeycomb immune surface -- prism scatter for fleet --
	@is_honeycomb host bloom.primals.eco thymus.primals.eco opsonize.primals.eco antibody.primals.eco cytokine.primals.eco receptor.primals.eco macrophage.primals.eco lysozyme.primals.eco complement.primals.eco epitope.primals.eco antigen.primals.eco interferon.primals.eco
	handle @is_honeycomb {
		reverse_proxy localhost:9753 {
			header_up X-Real-IP {remote_host}
			header_up X-Honeycomb "true"
			header_up X-Declared-Lang {>Accept-Language}
			header_up X-Declared-Sec {>Sec-Fetch-Mode}
		}
	}

	# -- Epitope concept redirects --
	@is_metrictensor host metric-tensor.primals.eco
	redir @is_metrictensor https://tuebor.primals.eco/analysis/metric-tensor/ permanent

	@is_scyborg host scyborg.primals.eco license.primals.eco
	redir @is_scyborg https://sporeprint.primals.eco/license/scyborg/ permanent

	@is_methodology host methodology.primals.eco
	redir @is_methodology https://sporeprint.primals.eco/methodology/scyborg-binary-genetic-bulwark/ permanent

	@is_outreach host outreach.primals.eco
	redir @is_outreach https://sporeprint.primals.eco/outreach/ permanent

	@is_hadr host hadr.primals.eco
	redir @is_hadr https://sporeprint.primals.eco/outreach/hadr-invitation/ permanent

	@is_desk host desk.primals.eco
	redir @is_desk https://tuebor.primals.eco/desk/ permanent

	# -- Default: unknown subdomains -> scatter (epitope sorter) --
	handle {
		reverse_proxy localhost:9753 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Declared-Lang {>Accept-Language}
			header_up X-Declared-Sec {>Sec-Fetch-Mode}
		}
	}
}
