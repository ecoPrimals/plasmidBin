	handle @facebook_bot {
		header Content-Type "text/html; charset=utf-8"
		respond `<!DOCTYPE html><html><head><meta property="og:title" content="Signal — What the Fleet Is Doing Right Now"><meta property="og:description" content="292+ IPs. 88,751+ requests. 13/sec. P != NP."><meta property="og:url" content="https://signal.primals.eco/"><meta property="og:type" content="website"><meta property="og:site_name" content="signal.primals.eco"></head><body>blackwall</body></html>` 200
	}
	# BLACKWALL: humans from facebook get signal
	@from_facebook header Referer *facebook.com*
	handle @from_facebook {
		redir https://signal.primals.eco/ temporary
	}

	handle {
		redir https://sporeprint.primals.eco{uri} permanent
	}
}
