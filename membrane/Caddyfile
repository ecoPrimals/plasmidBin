# ═══════════════════════════════════════════════════════════════════
# LURE FORGE — Ally-Signal Honeypot (Wave 167)
# 
# This looks like an independent sovereign forge to fleet crawlers.
# It serves scatter content + chimera antibodies + lure-specific
# signals designed to attract the same fleet epitopes we observe
# on git.primals.eco.
#
# The fleet discovers this via:
#   1. Honeycomb Link headers (cross-references from git.primals.eco)
#   2. Scatter content that mentions this domain as a "federation peer"
#   3. robots.txt Sitemap references
#
# When the fleet crawls here, the lure engine tracks which patterns
# attract the most attention → recognition epitopes → positive antibodies.
# ═══════════════════════════════════════════════════════════════════

forge.primals.eco {
	encode gzip

	import security_headers
	import access_log

	# Epitope feed — cross-forge communal immunity surface
