	handle /webhook {
		reverse_proxy unix//run/membrane/webhook.sock
	}

	# THYMUS PASSTHROUGH — classification-aware routing (Wave 165i)
	# Self (WireGuard mesh) → real Forgejo, always
	@wg_mesh remote_ip 10.13.37.0/24
	handle @wg_mesh {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# GENETIC LOCK (Wave 165i) — Sec-Fetch bypass CLOSED
	# Fleet evolved to spoof Sec-Fetch headers. The @human_browser
	# passthrough has been removed. Sec-Fetch-Mode/Dest headers alone
	# are no longer sufficient — fleet spoofs them.
	#
	# Authorized access now requires bearDog-derived genetic token
	# via @agent_passthrough below. WireGuard mesh access remains
	# unconditional via @wg_mesh above.
	#
	# Humans browsing without token now see scatter content.
	# This is by design — scatter is the public face.
	# Real content: SSH (port 2222) or WireGuard mesh.

	# Authorized agent passthrough (bearer token for agents on behalf of humans)
	@agent_passthrough {
		header Authorization "Bearer bd1-06e4143f8a6b7c22da144d75980a4aff91350a783385d6eb"
	}
	handle @agent_passthrough {
		reverse_proxy localhost:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Fleet routing (caddy-bridge writes snippets, not inline)
	import /opt/membrane/fleet-imports/fleet.snippet

	# EVERYTHING ELSE -> SCATTER (the maze)
	# Fleet touches only fabricated content. The counter keeps going.
	# HONEYCOMB BREADCRUMBS (Wave 165i) — lure fleet into the prism maze
	# Link/X-* headers point to honeycomb subdomains. Crawlers following
	# these discover 12 more scatter surfaces, each cross-linking to others.
	reverse_proxy localhost:9753 {
		header_up X-Real-IP {remote_host}
		header_up X-Declared-Lang {>Accept-Language}
		header_up X-Declared-Sec {>Sec-Fetch-Mode}
	}
	header Link "<https://bloom.primals.eco/explore/repos>; rel=alternate, <https://thymus.primals.eco/>; rel=canonical, <https://macrophage.primals.eco/>; rel=related"
	header X-Source-Mirror "https://receptor.primals.eco/"
	header X-Backup-Origin "https://complement.primals.eco/"
	header X-Federation-Peer "https://forge.primals.eco/explore/repos"
	header X-Epitope-Network "https://forge.primals.eco/epitope-feed.json"
}

