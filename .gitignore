# plasmidBin — binaries live in GitHub Releases, not in git.
# Only metadata.toml files and scripts are tracked.

# Exclude all primal binaries (they are downloaded via fetch.sh)
beardog/beardog
songbird/songbird
squirrel/squirrel
rhizocrypt/rhizocrypt
loamspine/loamspine
sweetgrass/sweetgrass
biomeos/biomeos
toadstool/toadstool
barracuda/barracuda
coralreef/coralreef
nestgate/nestgate
petaltongue/petaltongue
sourdough/sourdough
skunkbat/skunkbat

# Spring binaries
ludospring/ludospring
groundspring/groundspring
healthspring/healthspring_primal
neuralspring/neuralspring
wetspring/wetspring
primalspring/primalspring_primal

# Catch arch-suffixed assets left by harvest.sh
*/*-x86_64
*/*-aarch64

# Build artifacts
**/target/
